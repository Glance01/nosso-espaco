# GEMINI_API_KEY: Required for Gemini AI API calls (CV assistance & summary improvements).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for Netshop callback URLs and webhooks.
APP_URL="MY_APP_URL"

# NETSHOP API CONFIGURATION (MODO LIVE / MOCAMBIQUE)
# Chave de API secreta fornecida pelo portal Netshop (ex: ns_live_... ou ns_test_...)
NETSHOP_API_KEY=""

# Wallet ID do comerciante Netshop (identificador de 6 dígitos da sua carteira Netshop)
NETSHOP_WALLET_ID=""

# URL Base oficial da API Netshop
NETSHOP_BASE_URL="https://www.netshop.co.mz/api/v1"

# Segredo de validação de Webhook do Netshop
NETSHOP_WEBHOOK_SECRET=""

# Valor da subscrição mensal em Meticais (MZN)
PREMIUM_MONTHLY_PRICE_MZN="299"

