rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Resumes Collection
    match /resumes/{resumeId} {
      allow read, write: if true;
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow read, write: if true;
    }
  }
}
